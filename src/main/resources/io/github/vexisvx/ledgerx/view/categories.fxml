<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="io.github.vexisvx.ledgerx.ui.controller.CategoriesController"
            styleClass="content-area">
    <top>
        <VBox spacing="14">
            <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="0" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTitle" text="Categories" styleClass="page-header-title"/>
                    <Label fx:id="lblSubtitle" text="" styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="btnAdd" text="New Category" onAction="#add" styleClass="btn-primary"/>
            </HBox>
            <HBox styleClass="toolbar-strip">
                <ComboBox fx:id="typeFilter" prefWidth="130"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" text="" styleClass="page-subtitle"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane>
            <ScrollPane fx:id="catScroll" fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 14 0 0 0;">
                <TilePane fx:id="catGrid" styleClass="cat-grid" prefColumns="3" hgap="14" vgap="14"/>
            </ScrollPane>
            <VBox fx:id="emptyState" styleClass="empty-state-enhanced" visible="false" managed="false">
                <StackPane styleClass="empty-icon-circle">
                    <Label text="C" styleClass="empty-icon-enhanced"/>
                </StackPane>
                <Label fx:id="lblEmptyTitle" text="No categories yet" styleClass="empty-title-enhanced"/>
                <Label fx:id="lblEmptyDesc" text="Create your first category to start organizing your finances" styleClass="empty-desc-enhanced"/>
                <Button text="New Category" onAction="#add" styleClass="btn-primary"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
